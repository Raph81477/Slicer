/com,*********** Set Force Without Surface Effect Elements "Kraft" ***********
sfco,1,0,12,,,,,1   ! set and send X component values
sfe,_CM38_1,1,pres,1,0.
sfe,_CM38_2,2,pres,1,0.
sfe,_CM38_4,4,pres,1,0.
sfco,1,1,12,,,,,1   ! set and send Y component values
sfe,_CM38_1,1,pres,1,0.
sfe,_CM38_2,2,pres,1,0.
sfe,_CM38_4,4,pres,1,0.
sfco,1,2,12,,,,,1   ! set and send Z component values
sfe,_CM38_1,1,pres,1,5.30525490287983
sfe,_CM38_2,2,pres,1,5.30525490287983
sfe,_CM38_4,4,pres,1,5.30525490287983
nsel,all
esel,all
