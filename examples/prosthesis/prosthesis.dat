sfco,1,0,12,,,,,1   ! set and send X component values
sfe,_CM55_1,1,pres,1,-1.13688247849466e-002
sfe,_CM55_2,2,pres,1,-1.13688247849466e-002
sfe,_CM55_3,3,pres,1,-1.13688247849466e-002
sfe,_CM55_4,4,pres,1,-1.13688247849466e-002
sfco,1,1,12,,,,,1   ! set and send Y component values
sfe,_CM55_1,1,pres,1,-2.27376495698932e-002
sfe,_CM55_2,2,pres,1,-2.27376495698932e-002
sfe,_CM55_3,3,pres,1,-2.27376495698932e-002
sfe,_CM55_4,4,pres,1,-2.27376495698932e-002
sfco,1,2,12,,,,,1   ! set and send Z component values
sfe,_CM55_1,1,pres,1,0.
sfe,_CM55_2,2,pres,1,0.
sfe,_CM55_3,3,pres,1,0.
sfe,_CM55_4,4,pres,1,0.
nsel,all
esel,all
sfco,none		! resets the sfcontrol
